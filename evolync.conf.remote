server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name guiacafelandia.com.br;

    client_max_body_size 100m;
    proxy_hide_header X-Powered-By;

    ssl_certificate /etc/letsencrypt/live/guiacafelandia.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/guiacafelandia.com.br/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/guiacafelandia.com.br/chain.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location ^~ /admin/login {
        limit_req zone=auth burst=8 nodelay;
        limit_req_status 429;
        proxy_pass http://guia_cafelandia_web:3000;
        include /etc/nginx/conf.d/proxy_params.conf;
    }

    location ^~ /_next/static/ {
        proxy_pass http://guia_cafelandia_web:3000;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/conf.d/proxy_params.conf;
    }

    location / {
        proxy_pass http://guia_cafelandia_web:3000;
        include /etc/nginx/conf.d/proxy_params.conf;
    }
}
# END GUIA CAFELANDIA


