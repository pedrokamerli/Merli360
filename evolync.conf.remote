    listen 443 ssl; # josue-https
    listen [::]:443 ssl;
    server_name josue.evolyncagenda.com;

    ssl_certificate /etc/letsencrypt/live/josue.evolyncagenda.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/josue.evolyncagenda.com/privkey.pem;

    access_log /var/log/nginx/josue_ssl_access.log main;
    error_log /var/log/nginx/josue_ssl_error.log warn;

    location / {
        root /var/www/certbot/josue;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:css|js|jpg|jpeg|gif|png|webp|ico|svg|pdf)$ {
        root /var/www/certbot/josue;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }
}

