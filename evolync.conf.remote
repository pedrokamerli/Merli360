# Generated into nginx/conf.d/evolync.conf by scripts/vps/issue-certificates.sh.

server {
    listen 80;
    listen [::]:80;
    server_name www.evolyncagenda.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://evolyncagenda.com$request_uri;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name evolyncagenda.com app.evolyncagenda.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.evolyncagenda.com;

    ssl_certificate /etc/letsencrypt/live/evolyncagenda.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/evolyncagenda.com/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/evolyncagenda.com/chain.pem;

    return 301 https://evolyncagenda.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name evolyncagenda.com app.evolyncagenda.com;

    client_max_body_size 2m;
    limit_conn per_ip 20;

    ssl_certificate /etc/letsencrypt/live/evolyncagenda.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/evolyncagenda.com/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/evolyncagenda.com/chain.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; img-src 'self' data: blob: https:; font-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self';" always;

    location = /api/health {
        proxy_pass http://app:3000;
        include /etc/nginx/conf.d/proxy_params.conf;
    }

    location /api/auth/ {
        limit_req zone=auth burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://app:3000;
        include /etc/nginx/conf.d/proxy_params.conf;
    }

    location /api/public-booking {
        limit_req zone=booking burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://app:3000;
        include /etc/nginx/conf.d/proxy_params.conf;
    }

    location /api/ {
        limit_req zone=api burst=40 nodelay;
        limit_req_status 429;
        proxy_pass http://app:3000;
        include /etc/nginx/conf.d/proxy_params.conf;
    }

    location /_next/static/ {
        proxy_pass http://app:3000;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/conf.d/proxy_params.conf;
    }

    location / {
        proxy_pass http://app:3000;
        include /etc/nginx/conf.d/proxy_params.conf;
    }

    error_page 502 503 504 /50x.json;
    location = /50x.json {
        default_type application/json;
        return 503 '{"error":"Servico temporariamente indisponivel"}';
    }
}
server {
    listen 80;
    server_name gestao.evolyncagenda.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://merli360_app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
server {
    listen 443 ssl;
    server_name gestao.evolyncagenda.com;

    ssl_certificate /etc/letsencrypt/live/gestao.evolyncagenda.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gestao.evolyncagenda.com/privkey.pem;

    location / {
        proxy_pass http://merli360_app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Landing page temporaria Josue Traine
server {
    listen 80;
    listen [::]:80;
    server_name josue.evolyncagenda.com;

    access_log /var/log/nginx/josue_access.log main;
    error_log /var/log/nginx/josue_error.log warn;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        root /var/www/certbot/josue;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:css|js|jpg|jpeg|gif|png|webp|ico|svg|pdf)$ {
        root /var/www/certbot/josue;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }
}

# Landing pages test space
server {
    listen 80;
    listen [::]:80;
    server_name lp.evolyncagenda.com;

    access_log /var/log/nginx/lp_access.log main;
    error_log /var/log/nginx/lp_error.log warn;

    # TCA Advocacia landing
    location = /tcaadvocacia {
        proxy_pass http://tca-advocacia-landing:3000;
        include /etc/nginx/conf.d/proxy_params.conf;
    }

    location ^~ /tcaadvocacia/ {
        proxy_pass http://tca-advocacia-landing:3000;
        include /etc/nginx/conf.d/proxy_params.conf;
    }

    # TT Industria Mecanica landing
    location ^~ /ttindustria/assets/ {
        proxy_pass http://ttindustria_landing:3000/assets/;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/conf.d/proxy_params.conf;
    }

    location = /ttindustria {
        proxy_pass http://ttindustria_landing:3000;
        include /etc/nginx/conf.d/proxy_params.conf;
    }

    location ^~ /ttindustria/ {
        proxy_pass http://ttindustria_landing:3000;
        include /etc/nginx/conf.d/proxy_params.conf;
    }

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location ^~ /josue/ {
        root /var/www/certbot/lp;
        index index.html;
        try_files $uri $uri/ /josue/index.html;
    }

    location / {
        root /var/www/certbot/lp;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:css|js|jpg|jpeg|gif|png|webp|ico|svg|pdf)$ {
        root /var/www/certbot/lp;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }
}

# HTTPS landing page temporaria Josue Trainer
