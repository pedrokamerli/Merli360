server {
    listen 80;
    server_name agro.evolyncagenda.com;

    location ^~ /.well-known/acme-challenge/ {
        default_type text/plain;
        alias /var/www/certbot/.well-known/acme-challenge/;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name agro.evolyncagenda.com;

    ssl_certificate /etc/letsencrypt/live/agro.evolyncagenda.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agro.evolyncagenda.com/privkey.pem;

    location / {
        proxy_pass http://merli360_app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}


# BEGIN ARTEZZANO
server {
    listen 80;
    listen [::]:80;
    server_name artezzano.evolyncagenda.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name appartezano.evolyncagenda.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://artezzano_app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name artezzano.evolyncagenda.com;

    client_max_body_size 25m;
    proxy_hide_header X-Powered-By;

    ssl_certificate /etc/letsencrypt/live/artezzano.evolyncagenda.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/artezzano.evolyncagenda.com/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/artezzano.evolyncagenda.com/chain.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        proxy_pass http://artezzano_app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
# END ARTEZZANO

