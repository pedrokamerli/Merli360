generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                String                @id @default(cuid())
  name              String
  slug              String                @unique
  kind              String                @default("consultoria")
  brandName         String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  users             User[]
  clients           Client[]
  transactions      Transaction[]
  categories        Category[]
  invoices          Invoice[]
  adBudgets         AdBudget[]
  receivables       AccountReceivable[]
  payables          AccountPayable[]
  goals             Goal[]
  leads             Lead[]
  buyers            Buyer[]
  products          Product[]
  plantings         Planting[]
  harvests          Harvest[]
  stockMovements    StockMovement[]
  sales             Sale[]
  agendaEvents      AgendaEvent[]
  auditLogs         AuditLog[]
  financialAccounts FinancialAccount[]
  costCenters       CostCenter[]
  budgets           Budget[]
  budgetLines       BudgetLine[]
  financialTitles   FinancialTitle[]
  settlements       Settlement[]
  cashMovements     CashMovement[]
  transfers         Transfer[]
  bankImportBatches BankImportBatch[]
  bankTransactions  BankTransaction[]
  reconciliations   ReconciliationGroup[]
  attachments       Attachment[]
  pushSubscriptions WebPushSubscription[]
  notificationRules NotificationRule[]
  aiLearningRules   AiLearningRule[]
  assistantProfiles AssistantProfile[]
  assistantMessages AssistantMessage[]
  assistantPlans    AssistantPlan[]
  crmStages         CrmPipelineStage[]
  crmTemplates      CrmMessageTemplate[]
  crmActivities     CrmActivity[]
  graphicProducts   GraphicProduct[]
  graphicMaterials  GraphicMaterial[]
  graphicSuppliers  GraphicSupplier[]
  graphicPurchases  GraphicPurchase[]
  graphicInventoryMovements GraphicInventoryMovement[]
  graphicMaterialNeeds GraphicMaterialNeed[]
  graphicProcesses  GraphicProcess[]
  graphicOpportunities GraphicOpportunity[]
  graphicQuotes     GraphicQuote[]
  graphicOrders     GraphicOrder[]
  graphicProductionOrders GraphicProductionOrder[]
  graphicSettings   GraphicSetting[]
}

model User {
  id                 String             @id @default(cuid())
  tenantId           String
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  username           String             @unique
  passwordHash       String
  mustChangePassword Boolean            @default(false)
  name               String
  email              String?
  whatsapp           String?
  phone              String?
  document           String?
  address            String?
  addressNumber      String?
  district           String?
  city               String?
  state              String?
  zipCode            String?
  notes              String?
  role               String             @default("user")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  auditLogs          AuditLog[]
  aiLearningRules    AiLearningRule[]
  assistantProfiles  AssistantProfile[]
  crmActivities      CrmActivity[]
  graphicOpportunities GraphicOpportunity[]
  graphicQuotes      GraphicQuote[]
  moduleAccess       String             @default("all")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  status    String   @default("ok")
  message   String?
  metadata  String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}

model Client {
  id                  String              @id @default(cuid())
  tenantId            String?
  tenant              Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  fantasyName         String?
  document            String?
  stateRegistration   String?
  email               String?
  phone               String?
  whatsapp            String?
  responsibleName     String?
  responsibleRole     String?
  segment             String?
  website             String?
  instagram           String?
  address             String?
  addressNumber       String?
  district            String?
  city                String?
  state               String?
  zipCode             String?
  type                String
  monthlyValue        Float               @default(0)
  dueDay              Int?
  status              String              @default("ativo")
  services            String?
  mainChannel         String?
  notes               String?
  startDate           DateTime?
  nextAdjustment      DateTime?
  growthPotential     Float?
  estimatedHoursMonth Float?
  perceivedProfit     String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  transactions        Transaction[]
  invoices            Invoice[]
  adBudgets           AdBudget[]
  receivables         AccountReceivable[]
}

model Transaction {
  id            String   @id @default(cuid())
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date          DateTime
  description   String
  amount        Float
  type          String
  category      String
  subcategory   String?
  costCenter    String?
  account       String   @default("PJ")
  status        String   @default("conferencia")
  paymentMethod String?
  notes         String?
  attachmentUrl String?
  source        String?
  importHash    String?  @unique
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Category {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  type        String
  description String?
  createdAt   DateTime @default(now())
}

model Invoice {
  id                 String    @id @default(cuid())
  tenantId           String?
  tenant             Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId           String?
  client             Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  referenceMonth     String
  serviceDescription String
  amount             Float
  expectedIssueDate  DateTime?
  issueDate          DateTime?
  invoiceNumber      String?
  status             String    @default("emitir")
  fileUrl            String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model AdBudget {
  id               String    @id @default(cuid())
  tenantId         String?
  tenant           Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId         String?
  client           Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  platform         String
  campaign         String?
  objective        String?
  referenceMonth   String
  startDate        DateTime?
  endDate          DateTime?
  budgetType       String    @default("Conferir origem")
  approvedAmount   Float     @default(0)
  receivedAmount   Float     @default(0)
  spentAmount      Float     @default(0)
  balance          Float     @default(0)
  reimbursementDue Float     @default(0)
  reimbursedAmount Float     @default(0)
  account          String    @default("PJ")
  paymentMethod    String?
  status           String    @default("conferir")
  proofUrl         String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model AccountReceivable {
  id            String    @id @default(cuid())
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId      String?
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  description   String
  amount        Float
  dueDate       DateTime
  paidDate      DateTime?
  status        String    @default("pendente")
  type          String
  recurring     Boolean   @default(false)
  recurrence    String?
  recurrenceDay Int?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AccountPayable {
  id          String    @id @default(cuid())
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  description String
  category    String
  amount      Float
  dueDate     DateTime
  paidDate    DateTime?
  status      String    @default("pendente")
  recurring   Boolean   @default(false)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Goal {
  id           String   @id @default(cuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  currentValue Float    @default(0)
  targetValue  Float
  gap          Float    @default(0)
  actionPlan   String?
  deadline     String?
  status       String   @default("em andamento")
  owner        String   @default("Pedro")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Lead {
  id            String    @id @default(cuid())
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  segment       String?
  city          String?
  state         String?
  type          String    @default("Imobiliaria")
  companyName   String?
  contact       String?
  normalizedPhone String?
  email         String?
  address       String?
  website       String?
  socialLink    String?
  googleMapsUrl String?
  publicSource  String?
  sourceCriteria String?
  verifiedAt    DateTime?
  ownerName     String?
  temperature   String    @default("Morno")
  priority      String    @default("Media")
  interestService String?
  hasOpportunity Boolean   @default(false)
  opportunityName String?
  opportunityStatus String @default("aberta")
  expectedCloseDate DateTime?
  closedAt       DateTime?
  wonValue       Float     @default(0)
  lossReason     String?
  probabilityManual Boolean @default(false)
  origin        String?
  lastContactAt DateTime?
  lastActionByUserId String?
  lastActionByName String?
  lastActionAt DateTime?
  contactLockedUntil DateTime?
  nextAction    String?
  attempts      Int       @default(0)
  lastContactResult String?
  optOut        Boolean   @default(false)
  doNotContact  Boolean   @default(false)
  blockReason   String?
  archivedAt    DateTime?
  status        String    @default("Novo")
  proposedValue Float     @default(0)
  closeChance   Float     @default(0)
  nextFollowUp  DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  activities    CrmActivity[]

  @@index([tenantId, status])
  @@index([tenantId, city])
  @@index([tenantId, normalizedPhone])
  @@index([tenantId, opportunityStatus])
  @@index([tenantId, nextFollowUp])
}

model CrmPipelineStage {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("violet")
  position  Int      @default(0)
  kind      String   @default("active")
  defaultProbability Float @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, position])
}

model CrmMessageTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  content   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
}

model CrmActivity {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type           String   @default("Follow-up")
  channel        String   @default("Outro")
  result         String?
  note           String?
  nextAction     String?
  nextActionDate DateTime?
  status         String   @default("concluida")
  createdAt      DateTime @default(now())

  @@index([tenantId, leadId, createdAt])
}

model GraphicProduct {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  category    String   @default("Impressos")
  unit        String   @default("unidade")
  description String?
  status      String   @default("ACTIVE")
  validationStatus String @default("PENDING_VALIDATION")
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  versions    GraphicProductVersion[]
  components  GraphicProductComponent[]
  processes   GraphicProductProcess[]
  quoteItems  GraphicQuoteItem[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
}

model GraphicProductVersion {
  id          String   @id @default(cuid())
  tenantId    String
  productId   String
  product     GraphicProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  version     Int      @default(1)
  snapshot    String
  status      String   @default("ACTIVE")
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, productId, version])
  @@index([tenantId, productId])
}

model GraphicMaterial {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  unit        String   @default("m2")
  currentStock Float   @default(0)
  minStock     Float   @default(0)
  currentCostCents Int @default(0)
  wastePercent Float  @default(0)
  supplier    String?
  supplierId  String?
  supplierRef GraphicSupplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  location    String?
  status      String   @default("ACTIVE")
  validationStatus String @default("PENDING_VALIDATION")
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  costHistory GraphicMaterialCostHistory[]
  components  GraphicProductComponent[]
  quoteCosts  GraphicQuoteItemCost[]
  consumptions GraphicMaterialConsumption[]
  inventoryMovements GraphicInventoryMovement[]
  purchaseItems GraphicPurchaseItem[]
  materialNeeds GraphicMaterialNeed[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model GraphicSupplier {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  document    String?
  email       String?
  phone       String?
  contactName String?
  status      String   @default("ACTIVE")
  notes       String?
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  materials   GraphicMaterial[]
  purchases   GraphicPurchase[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
}

model GraphicInventoryMovement {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  materialId  String
  material    GraphicMaterial @relation(fields: [materialId], references: [id], onDelete: Restrict)
  type        String
  quantity    Float
  unitCostCents Int?
  referenceType String?
  referenceId String?
  note        String?
  occurredAt  DateTime @default(now())
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, referenceType, referenceId, materialId, type])
  @@index([tenantId, materialId, occurredAt])
  @@index([tenantId, type])
}

model GraphicPurchase {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number      Int
  supplierId  String?
  supplier    GraphicSupplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  status      String   @default("DRAFT")
  expectedAt  DateTime?
  orderedAt   DateTime?
  receivedAt  DateTime?
  notes       String?
  totalCents  Int      @default(0)
  financialTitleId String?
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       GraphicPurchaseItem[]

  @@unique([tenantId, number])
  @@index([tenantId, status, expectedAt])
}

model GraphicPurchaseItem {
  id          String   @id @default(cuid())
  tenantId    String
  purchaseId  String
  purchase    GraphicPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  materialId  String
  material    GraphicMaterial @relation(fields: [materialId], references: [id], onDelete: Restrict)
  quantity    Float
  receivedQuantity Float @default(0)
  unitCostCents Int
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, purchaseId])
  @@index([tenantId, materialId])
}

model GraphicMaterialNeed {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  materialId  String
  material    GraphicMaterial @relation(fields: [materialId], references: [id], onDelete: Restrict)
  productionOrderId String?
  requiredQuantity Float
  availableQuantity Float
  missingQuantity Float
  status      String   @default("OPEN")
  resolvedByPurchaseId String?
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, productionOrderId, materialId])
  @@index([tenantId, status])
}

model GraphicMaterialCostHistory {
  id          String   @id @default(cuid())
  tenantId    String
  materialId  String
  material    GraphicMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  costCents   Int
  source      String   @default("MANUAL")
  status      String   @default("PENDING_VALIDATION")
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, materialId, createdAt])
}

model GraphicProcess {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  type        String   @default("INTERNAL")
  unit        String   @default("hora")
  costCents   Int      @default(0)
  setupCostCents Int   @default(0)
  status      String   @default("ACTIVE")
  validationStatus String @default("PENDING_VALIDATION")
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    GraphicProductProcess[]
  quoteCosts  GraphicQuoteItemCost[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
}

model GraphicProductComponent {
  id          String   @id @default(cuid())
  tenantId    String
  productId   String
  product     GraphicProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  materialId  String
  material    GraphicMaterial @relation(fields: [materialId], references: [id], onDelete: Restrict)
  quantity    Float    @default(1)
  wastePercent Float   @default(0)
  status      String   @default("ACTIVE")
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, productId])
  @@index([tenantId, materialId])
}

model GraphicProductProcess {
  id          String   @id @default(cuid())
  tenantId    String
  productId   String
  product     GraphicProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  processId   String
  process     GraphicProcess @relation(fields: [processId], references: [id], onDelete: Restrict)
  quantity    Float    @default(1)
  status      String   @default("ACTIVE")
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, productId])
  @@index([tenantId, processId])
}

model GraphicOpportunity {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId    String?
  leadId      String?
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  title       String
  source      String?
  productInterest String?
  estimatedValueCents Int @default(0)
  nextAction  String?
  nextFollowUp DateTime?
  lossReason  String?
  status      String   @default("OPEN")
  qualityAlert String?
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  activities  GraphicActivity[]
  tasks       GraphicTask[]
  quotes      GraphicQuote[]

  @@index([tenantId, status])
  @@index([tenantId, nextFollowUp])
  @@index([tenantId, ownerId])
}

model GraphicPipelineStage {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  position    Int      @default(0)
  kind        String   @default("ACTIVE")
  active      Boolean  @default(true)
  createdById String?
  updatedById String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, position])
}

model GraphicActivity {
  id          String   @id @default(cuid())
  tenantId    String
  opportunityId String?
  opportunity GraphicOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userId      String?
  type        String   @default("INTERACTION")
  channel     String?
  note        String?
  result      String?
  status      String   @default("DONE")
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, opportunityId, createdAt])
}

model GraphicTask {
  id          String   @id @default(cuid())
  tenantId    String
  opportunityId String?
  opportunity GraphicOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  assignedToId String?
  title       String
  dueDate     DateTime?
  status      String   @default("OPEN")
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, dueDate])
}

model GraphicQuote {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity GraphicOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  clientId    String?
  responsibleId String?
  responsible User?    @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  number      Int
  version     Int      @default(1)
  shareToken  String?
  status      String   @default("DRAFT")
  validUntil  DateTime
  paymentTerms String?
  notes       String?
  subtotalCents Int    @default(0)
  discountCents Int    @default(0)
  urgencyCents Int     @default(0)
  freightCents Int     @default(0)
  installationCents Int @default(0)
  totalCostCents Int   @default(0)
  totalPriceCents Int  @default(0)
  minimumPriceCents Int @default(0)
  marginPercent Float  @default(0)
  markupPercent Float  @default(0)
  approvalRequired Boolean @default(false)
  approvalReason String?
  approvedAt DateTime?
  approvedById String?
  viewedAt DateTime?
  cancelledAt DateTime?
  cancelReason String?
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       GraphicQuoteItem[]
  versions   GraphicQuoteVersion[]
  approvals  GraphicApprovalRequest[]
  orders     GraphicOrder[]

  @@unique([tenantId, number, version])
  @@index([tenantId, status])
  @@index([tenantId, clientId])
  @@index([shareToken])
}

model GraphicQuoteVersion {
  id          String   @id @default(cuid())
  tenantId    String
  quoteId     String
  quote       GraphicQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    String
  status      String   @default("ACTIVE")
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, quoteId, version])
  @@index([tenantId, quoteId])
}

model GraphicQuoteItem {
