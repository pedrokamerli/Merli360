  filename     String
  originalName String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  linkedModel  String?
  linkedId     String?
  createdById  String?
  createdAt    DateTime @default(now())

  @@index([tenantId, linkedModel, linkedId])
  @@index([tenantId, createdAt])
}

model WebPushSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, active])
}

model NotificationRule {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  type        String
  daysBefore  Int      @default(1)
  enabled     Boolean  @default(true)
  channel     String   @default("push")
  lastSentKey String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, type, daysBefore, channel])
  @@index([tenantId, enabled])
}

model AiConfiguration {
  id               String   @id @default("global")
  provider         String   @default("gemini")
  model            String   @default("gemini-flash-latest")
  apiKey           String?
  geminiModel      String?
  geminiApiKey     String?
  openaiModel      String?
  openaiApiKey     String?
  cheapProvider    String   @default("gemini")
  smartProvider    String   @default("openai")
  visionProvider   String   @default("openai")
  systemContext    String?
  webSearchEnabled Boolean  @default(true)
  autoExecute      Boolean  @default(false)
  updatedById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AssistantProfile {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId              String?
  user                User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  assistantName       String   @default("Assistente 360")
  ownerName           String?
  businessName        String?
  goalsText           String?
  preferences         String?
  personality         String?
  memoryText          String?
  onboardingStep      Int      @default(0)
  onboardingCompleted Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId])
  @@index([userId])
}

model AssistantMessage {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  role      String
  content   String
  metadata  String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, role])
}

model AssistantPlan {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String?
  conversationId  String?
  idempotencyKey  String
  intent          String
  tool            String
  riskLevel       String
  status          String   @default("Draft")
  originalMessage String
  operation       String
  plan            String
  result          String?
  error           String?
  expiresAt       DateTime?
  confirmedAt     DateTime?
  executedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, userId, status])
  @@index([tenantId, createdAt])
}

model PublicQuestionnaire {
  id          String                    @id @default(cuid())
  slug        String                    @unique
  title       String
  description String?
  questions   String
  active      Boolean                   @default(true)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  submissions PublicQuestionnaireSubmission[]

  @@index([active])
}

model PublicQuestionnaireSubmission {
  id              String              @id @default(cuid())
  questionnaireId String
  questionnaire   PublicQuestionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  respondentName  String?
  respondentPhone String?
  respondentEmail String?
  answers         String
  ip              String?
  userAgent       String?
  createdAt       DateTime            @default(now())

  @@index([questionnaireId, createdAt])
}
